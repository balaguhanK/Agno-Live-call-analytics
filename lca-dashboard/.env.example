# Copy to .env and fill in values. .env is git-ignored.
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Never put secrets in VITE_ variables.

# ---------- Frontend (exposed to browser) ----------
VITE_API_BASE_URL=/api

# ---------- Go backend (lca-backend) ----------
PORT=8090
# true when served over HTTPS
COOKIE_SECURE=false
# Serve the built dashboard from the Go server (optional)
# STATIC_DIR=../lca-dashboard/dist
# Bearer token FreeSWITCH and ASR workers use for /api/ingest/*
INGEST_TOKEN=change-me-to-a-long-random-string

# ---------- Deepgram live transcription (Stream Audio page) ----------
# Server-side only; never prefix with VITE_. Empty = browser speech recognition.
DEEPGRAM_API_KEY=
# Optional model override (default nova-3)
# DEEPGRAM_MODEL=nova-3
# Extra words for the speech model to favour (names, products), comma separated
# DEEPGRAM_KEYTERMS=Acme Bank,Babu

# ---------- FreeSWITCH (Event Socket Layer) ----------
FREESWITCH_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=change-me
FREESWITCH_SIP_DOMAIN=127.0.0.1
FREESWITCH_SIP_PORT=5060
# SIPREC / media streaming
FREESWITCH_SIPREC_PORT=5080
FREESWITCH_RTP_START_PORT=16384
FREESWITCH_RTP_END_PORT=16484
FREESWITCH_RECORDINGS_DIR=/var/lib/freeswitch/recordings

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# ---------- PostgreSQL ----------
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=lca
PGUSER=lca
PGPASSWORD=change-me
PGSSLMODE=disable
DATABASE_URL=postgresql://lca:change-me@127.0.0.1:5433/lca?sslmode=disable

# ---------- SIPREC recorder (npm run srs) ----------
# SIP port the SRC (SBC/PBX) sends recording sessions to, over UDP and TCP.
# Not 5060/5080: FreeSWITCH uses those by default
SRS_SIP_PORT=5090
SRS_BIND_IP=0.0.0.0
# IP put in SDP answers; must be reachable by the SRC for RTP
SRS_MEDIA_IP=127.0.0.1
SRS_RTP_PORT_MIN=30000
SRS_RTP_PORT_MAX=30200
SRS_LANGUAGE=en-IN
# End a recording if no audio arrives for this long
SRS_RTP_TIMEOUT=30s
# Where the recorder posts transcripts (uses INGEST_TOKEN)
# BACKEND_URL=http://localhost:8090

# ---------- Browser phone via FreeSWITCH (Phone page) ----------
# SIP over WebSocket on FreeSWITCH's internal profile, and its SIP domain
# (FreeSWITCH's default domain is this PC's LAN IP)
FS_WS_URL=ws://192.168.1.10:5066
FS_SIP_DOMAIN=192.168.1.10
# What customers dial to reach an agent
FS_QUEUE_NUMBER=5000
# Derives each agent's SIP password; generate a long random value
FS_SIP_SECRET=

# ---------- Embeddings (local, via Ollama) ----------
# For semantic search, e.g. the Agent Assist knowledge base. Install the model with:
#   ollama pull embeddinggemma
EMBED_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
# Local chat model that writes the bot's answers from the passages found
# (RAG). Install with: ollama pull gemma2:2b  |  LLM_MODEL=off quotes passages instead
LLM_MODEL=gemma2:2b
# pgvector searches and saves are also written here (relative to lca-backend);
# open it in your editor to watch them. PGVECTOR_LOG=off logs to the console only
PGVECTOR_LOG=logs/pgvector.log

# ---------- Call categories ----------
# Categories whose names match this regular expression are alerts: shown in
# red and counted in the call's alerts. ".*" makes every category an alert.
CATEGORY_ALERT_REGEX=ManagerEscalation

# ---------- Call recordings (Phone page) ----------
# Folder (relative to lca-backend) where the browser phone's stereo call
# recordings are kept: agent on the left channel, customer on the right.
# Played back on the call page and charted in Post-Call Analytics.
RECORDINGS_DIR=recordings
